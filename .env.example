# Copy to .env and fill in. .env is gitignored — on Vercel these same three
# variables must also be set under Settings → Environment Variables.

# Supabase project (Dashboard → Project Settings → API).
# Until these are filled in, the site falls back to the cars in src/data.js.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public base URL of the site, NO trailing slash.
# Used for the canonical link, the Open Graph / Twitter image, the JSON-LD,
# robots.txt and sitemap.xml. This is the single place the domain is written —
# change it here when you point a real domain at the site.
VITE_SITE_URL=
